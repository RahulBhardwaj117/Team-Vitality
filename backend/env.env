# ============================================
# AgriUrbanAI Backend Environment Variables
# Copy this file to .env and configure your settings
# ============================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5500

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/agriurbanai
DB_NAME=agriurbanai

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Weather API Configuration
OPENWEATHER_API_KEY=your-openweather-api-key
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_UPDATE_INTERVAL=1800000

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Email Configuration (for alerts and notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=noreply@agriurban.ai
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=AgriUrbanAI <noreply@agriurban.ai>

# File Upload Configuration
MAX_FILE_SIZE=10485760
FILE_UPLOAD_PATH=./uploads

# Security Configuration
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Socket.IO Configuration
SOCKET_CORS_ORIGIN=http://localhost:5500

# External API Keys
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
SENTINEL_HUB_API_KEY=your-sentinel-hub-api-key

# ML Model Configuration
MODEL_UPDATE_INTERVAL=3600000
PREDICTION_CONFIDENCE_THRESHOLD=0.8

# Backup Configuration
BACKUP_INTERVAL=86400000
BACKUP_RETENTION_DAYS=30

# Demo Configuration
DEMO_MODE=true
DEMO_USERS_ENABLED=true

# Monitoring and Analytics
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=365

# Cache Configuration
CACHE_TTL=3600
WEATHER_CACHE_TTL=1800
USER_CACHE_TTL=7200

# Internal API Key (auto-generated)
INTERNAL_API_KEY=your-internal-api-key

# Twilio Configuration
TWILIO_ACCOUNT_SID=ACcab7e2096afd9d67ef9fd512c440ee0a
TWILIO_AUTH_TOKEN=fbe95b79ba5b63b2a946ec07a33abf4b
TWILIO_PHONE=+12762462613

# Gemini Configuration
GEMINI_API_KEY=AIzaSyA5BuCNj1fgJNnwryjjLUKxjIluCzSrbnc
