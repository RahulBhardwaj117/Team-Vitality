{
  "name": "agriurbanai-backend",
  "version": "1.0.0",
  "description": "Backend API for AgriUrbanAI platform",
  "main": "server.js",
  "scripts": {
    "start": "node --dns-result-order=ipv4first server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "seed": "node scripts/seedDatabase.js",
    "seed:reset": "node scripts/seedDatabase.js --reset",
    "setup": "node scripts/setup.js",
    "setup:interactive": "node scripts/setup.js",
    "setup:non-interactive": "node scripts/setup.js",
    "clean": "rm -rf logs/*.log uploads/*",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docker:build": "docker build -t agriurbanai-backend .",
    "docker:run": "docker run -p 5000:5000 agriurbanai-backend"
  },
  "keywords": [
    "agriculture",
    "urban-planning",
    "weather",
    "ai",
    "api"
  ],
  "author": "AgriUrbanAI Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "redis": "^4.6.10",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
